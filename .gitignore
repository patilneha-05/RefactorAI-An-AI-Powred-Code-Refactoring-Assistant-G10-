# ==========================================================================
# RefactorAI — repository-wide ignore rules
# (frontend/ also has its own .gitignore; this one covers the whole project)
# ==========================================================================

# --------------------------------------------------------------- Secrets
# Never commit real environment files — keep the *.example templates instead.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Packaging / build
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ------------------------------------------------------------ Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ------------------------------------------------------------------ Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------------- RefactorAI runtime state
# Active-project pointer, local registry DB and per-agent debug dumps.
backend/.state.json
backend/.llm_call_log.log
backend/data/*.db
backend/data/*.db-*
backend/debug/
.airefactor.db
.airefactor.db-*

# --------------------------------------------------------- Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ------------------------------------------------------------------ Misc
*.tmp
*.bak
