DOPPLER_TOKEN=your_doppler_token_here
DEBUG_LINES=True
GROQ_API_KEY=your_groq_api_key_here
COMPLETE_PROJECT_CONTEXT=False
# Comma-separated origins allowed to call this API from a browser (use "*" for any)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex for extra allowed origins (default allows any localhost/127.0.0.1 port for local dev;
# set to an empty value to disable)
CORS_ALLOWED_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# --------------------------------------------------------------------------- #
# Authentication
# --------------------------------------------------------------------------- #
# REQUIRED in production. Signing key for JWT access tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset a random key is generated at startup (dev only) which invalidates all
# sessions on restart.
JWT_SECRET=change_me_generate_a_long_random_secret

# Access-token lifetime (minutes). Keep short.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh-token lifetime (days) when "Remember me" is selected (1 day otherwise).
REFRESH_TOKEN_EXPIRE_DAYS=7
# Password-reset token lifetime (minutes).
PASSWORD_RESET_EXPIRE_MINUTES=30

# Frontend origin(s) — used for the password-reset link and post-OAuth redirects.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173

# Refresh cookie flags. Set COOKIE_SECURE=true when serving over HTTPS.
# Use COOKIE_SAMESITE=none together with COOKIE_SECURE=true for cross-site prod.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --------------------------------------------------------------------------- #
# Google OAuth (optional — leave blank to disable Google sign-in)
# --------------------------------------------------------------------------- #
# Public client ID (must match the frontend's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
# Backend-only client secret. Never expose this to the browser.
GOOGLE_CLIENT_SECRET=
