# Base URL of the RefactorAI backend (FastAPI, default port 8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth client ID (PUBLIC — safe to expose). Leave empty to disable the
# Google sign-in buttons. Never put the Google client *secret* here.
# Create an OAuth 2.0 Web client in the Google Cloud console and register the
# authorized redirect URI: <frontend-origin>/auth/google/callback
VITE_GOOGLE_CLIENT_ID=
